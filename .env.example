# Copy to .env to override defaults. Every variable is optional: `docker compose up -d --build`
# works with no .env file using the development values shown here.

# ---- environment ---------------------------------------------------------------------------
# development | test | production. Production refuses to start with default secrets,
# development seed passwords, ENABLE_TEST_HOOKS=true or COOKIE_SECURE=false.
APP_ENV=development
# Host interface nginx binds. Override for deployments that intentionally accept remote traffic.
HTTP_BIND=127.0.0.1
# Host port nginx listens on (http://localhost:8080).
HTTP_PORT=8080
LOG_LEVEL=INFO

# ---- PostgreSQL (single source of truth) ---------------------------------------------------
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
POSTGRES_DB=ticketing
# Max connections per API process (3 replicas x 10 + workers stays well under max_connections=200).
DB_POOL_MAX=10

# ---- secrets --------------------------------------------------------------------------------
# Session/CSRF signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
# Shared HMAC secret between the API and payment-mock callbacks.
PAYMENT_WEBHOOK_SECRET=dev-insecure-change-me
# Merchant API credential, separate from the callback HMAC secret. Replace it in production.
PAYMENT_PROVIDER_TOKEN=dev-provider-token-change-me
# Destination for signed callbacks sent by payment-mock, including queued retries.
PAYMOCK_CALLBACK_URL=http://api:8000/api/v1/payments/callbacks

# ---- cookies --------------------------------------------------------------------------------
# false (default, plain http://localhost): session cookie `sid` without Secure.
# true (TLS deployments): cookie `__Host-sid` with Secure. Browsers reject __Host- cookies over http.
COOKIE_SECURE=false

# ---- seed accounts (created automatically on startup) ---------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin#Dev2026!
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User#Dev2026!
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=Viewer#Dev2026!

# ---- booking --------------------------------------------------------------------------------
# Seat hold lifetime before an unpaid order expires (seconds). Decided by the database clock.
HOLD_TTL_SECONDS=600

# ---- runtime database role (least privilege; the POSTGRES_USER above only runs migrations) --
APP_DB_USER=ticketing_app
APP_DB_PASSWORD=ticketing_app
