# 複製為 repo 根目錄的 .env 可覆蓋 compose.yaml 的插值預設值；shell 同名變數優先。
# 下方啟用的值均為開發預設值。沒有 .env 也可直接 docker compose up -d --build。
# 後半部的註解列出其他程序環境變數。Settings 直接讀程序環境（env_file=None）。
# 設定值若未出現在 Compose 的插值中，需由 shell 傳給本機程序，或透過
# Compose override 在服務的 environment 中注入。只加入 .env 不會傳進容器。
# 來源：compose.yaml:4、backend/src/ticketing/core/settings.py:22。

# ── 環境與入口（Compose 插值） ──
# 後端 Settings、paymock：development / test / production。在 production 中，
# Settings 拒絕開發用 secrets、預設 seed 密碼、弱資料庫密碼、測試 hook 及非 Secure cookie。
APP_ENV=development
# Compose → nginx：host 綁定位址與 port，容器內固定為 8080。
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Compose → api：副本數。每個副本是單一 Uvicorn 程序（約用滿 1 核心），nginx 依 DNS 自動分流。
API_REPLICAS=3
# api、worker、relay、collector、seed：JSON 日誌層級。
LOG_LEVEL=INFO

# ── PostgreSQL（Compose 插值） ──
# postgres 初始化、migrate DSN：schema owner 帳號與密碼。
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing
# postgres 初始化、migrate 與 runtime DSN：資料庫名稱。
POSTGRES_DB=ticketing
# postgres 初始化與 runtime DSN：低權限服務角色與密碼。
# migrate 另讀 APP_DB_USER 決定授權對象。已初始化的 pg_data 保留既有帳號與密碼。
APP_DB_USER=ticketing_app
APP_DB_PASSWORD=ticketing_app
# api、worker、relay、collector：每個程序的 PostgreSQL 連線池上限。
DB_POOL_MAX=10
# 背景維護會清除已編序超過 1 小時的座位 outbox 列。回放缺少所需序號時，客戶端會重新取得快照。

# ── Session、金流與鎖位（Compose 插值） ──
# api：CSRF 與簽章 cursor 的金鑰。
SECRET_KEY=dev-insecure-change-me
# api、paymock：回呼 HMAC 的共用金鑰。
PAYMENT_WEBHOOK_SECRET=dev-insecure-change-me
# api、worker、paymock：merchant service token，必須與回呼金鑰不同。
PAYMENT_PROVIDER_TOKEN=dev-provider-token-change-me
# paymock：啟動時載入的固定回呼 URL，Compose 預設直接送到 api。獨立執行時需提供此 URL、回呼金鑰與 service token。
PAYMOCK_CALLBACK_URL=http://api:8000/api/v1/payments/callbacks
# api：true 使用帶 Secure 的 __Host-sid；false 使用 sid，供本機 HTTP 開發。
COOKIE_SECURE=false
# api：待付款鎖位期限，單位為秒，由 PostgreSQL 時鐘判定。
HOLD_TTL_SECONDS=600

# ── 預設帳號（Compose 插值，seed 讀取） ──
# 各角色的登入 email 與密碼；既有同 email 帳號的密碼由資料庫保留。
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin#Dev2026!
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=User#Dev2026!
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=Viewer#Dev2026!

# ── 連線、日誌與程序入口（程序環境／Compose override） ──
# api、seed、worker、relay、collector、migrate：PostgreSQL DSN。
# Settings 預設如下；直接執行 Alembic 時預設 host 是 localhost。
# Compose runtime DSN 依 APP_DB_USER / APP_DB_PASSWORD / POSTGRES_DB 組成，
# migrate DSN 依 POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 組成。
# DATABASE_URL=postgresql://ticketing:ticketing@postgres:5432/ticketing
# api、worker、relay、collector、背景服務 healthcheck：Redis DSN（Compose 同值）。
# REDIS_URL=redis://redis:6379/0
# api：PostgreSQL application_name。背景服務用各自服務名。
# SERVICE_NAME=api
# api：主要連線池最少連線數。背景服務 runner 的最小值為 1。
# DB_POOL_MIN=2
# api、worker、relay、collector：取得連線的逾時（秒）。
# DB_POOL_ACQUIRE_TIMEOUT_S=1.0
# api、worker、relay、collector：SQL 敘述、鎖等待、閒置交易逾時（毫秒）。
# DB_STATEMENT_TIMEOUT_MS=2000
# DB_LOCK_TIMEOUT_MS=500
# DB_IDLE_IN_TX_TIMEOUT_MS=5000
# api、seed、worker、relay、collector、paymock：JSON 日誌目錄，供 collector 持續讀取。
# 預設只輸出至 stdout，Compose 固定為 /data/logs。
# LOG_DIR=/data/logs
# api、paymock：Uvicorn 監聽 port。Compose proxy 與 healthcheck 使用 8000。
# PORT=8000
# api：可提供 X-Forwarded-* 的 proxy IP；程序預設 *，Compose 固定為 nginx 的 IP。
# FORWARDED_ALLOW_IPS=172.28.0.200
# api：shutdown 設定 readiness 後、開始 Uvicorn graceful shutdown 前的等待秒數。
# SHUTDOWN_DRAIN_SECONDS=0.0

# ── 驗證與限流（程序環境／Compose override） ──
# api：狀態變更請求可使用的精確 Origin，JSON 陣列。
# ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
# api：session 閒置期限（分）、絕對期限（小時）與 CSRF 金鑰版本。
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_HOURS=12
# CSRF_KEY_VERSION=1
# api、seed：Argon2id 迭代成本、每次雜湊記憶體（KiB）、平行度、每程序雜湊併發上限。
# ARGON2_TIME_COST=2
# ARGON2_MEMORY_KIB=19456
# ARGON2_PARALLELISM=1
# ARGON2_MAX_CONCURRENCY=4
# api：每 email 15 分鐘登入失敗門檻、每 IP 每分鐘登入、每 IP 每小時註冊、每秒全域登入。
# RATE_LIMIT_LOGIN_PER_EMAIL=10
# RATE_LIMIT_LOGIN_PER_IP=50
# RATE_LIMIT_REGISTER_PER_IP=10
# RATE_LIMIT_LOGIN_GLOBAL_PER_S=300

# ── 訂票、檔案、付款與監控（程序環境／Compose override） ──
# api：同一使用者在同一活動的保留張數上限，可設 1–4。
# MAX_TICKETS_PER_USER_EVENT=4
# api、worker：匯入檔目錄；api：單檔大小上限（20 MiB）。
# IMPORT_DIR=/data/imports
# IMPORT_MAX_BYTES=20971520
# api、worker：匯入列數上限，worker 最多處理 100,000 列。
# IMPORT_MAX_ROWS=100000
# api：報表暫存目錄、匯出磁碟配額（2 GiB）。
# EXPORT_DIR=/data/exports
# EXPORT_DISK_QUOTA_BYTES=2147483648
# api、worker：內部付款服務 URL，Compose 固定為同值。
# PAYMENT_PROVIDER_URL=http://paymock:8000
# api：產生 checkout_url 使用的公開網址。變更入口時應配合公開 Origin 更新。
# PAYMENT_CHECKOUT_BASE_URL=http://localhost:8080/pay
# paymock：SQLite 檔案。程序預設 /tmp/ticketing-paymock.sqlite3，Compose 固定為 volume 路徑。
# PAYMOCK_STORE_PATH=/data/paymock/store.sqlite3
# collector：nginx 日誌掛載目錄與 stub_status 探測 URL。
# NGINX_LOG_DIR=/data/nginx-logs
# NGINX_STATUS_URL=http://nginx:8080/nginx_status

# ── 測試與本機前端 ──
# api：測試 hook 預設關閉，compose.test.yaml 啟用。BOOKING_STRATEGY 預設未設定；
# 測試 hook 開啟且為 naive 時才查找由測試注入的替代策略。
# ENABLE_TEST_HOOKS=false
# BOOKING_STRATEGY=
# paymock：注入回呼延遲（秒）、停止配送、重送回呼。兩個 flag 皆以 1 啟用。
# PAYMOCK_DELAY_CALLBACK_S=0
# PAYMOCK_DROP_CALLBACKS=0
# PAYMOCK_DUPLICATE_CALLBACKS=0
# compose.test.yaml → 後端測試：Redis DB 編號與 PostgreSQL template 名。
# TEST_REDIS_DB=0
# TEST_TEMPLATE_DB=ticketing_template
# 後端 pytest：整合測試用 PostgreSQL admin DSN。host 執行時預設未設定。
# TEST_ADMIN_DATABASE_URL=
# Vite dev server（shell）：/api 與 /pay/ 的代理目的地。
# TICKETING_ORIGIN=http://localhost:8080
# Playwright（shell）：預設未設定，填入口 URL 可執行 nginx 煙霧測試。
# 來源：frontend/playwright.config.ts:3、frontend/tests/e2e/nginx.spec.ts:6。
# TICKETING_SMOKE_ORIGIN=
# TICKETING_SMOKE_EVENT_ID=
# TICKETING_SMOKE_USER_EMAIL=user@example.com
# TICKETING_SMOKE_USER_PASSWORD=User#Dev2026!
# TICKETING_SMOKE_VIEWER_EMAIL=viewer@example.com
# TICKETING_SMOKE_VIEWER_PASSWORD=Viewer#Dev2026!
# TICKETING_SMOKE_ADMIN_EMAIL=admin@example.com
# TICKETING_SMOKE_ADMIN_PASSWORD=Admin#Dev2026!
# 需提供已匯入座位且已發布的活動 ID 與三組帳號。1 加跑會寫入資料的流程。
# TICKETING_SMOKE_WRITE=0
# pytest：1 使 naive 案例直接暴露不變式斷言失敗。Compose 須用 run -e 傳入。
# 來源：backend/tests/booking/test_booking.py:121。
# BREAK_IT_RAW=0
# Excel 500,000 筆匯出 opt-in pytest。填 API URL 與測試資料的活動 ID，
# 提供可讀取報表的 Admin 或 Viewer 憑證、允許的登入 Origin，以及
# 匯出 API 容器 cgroup v2 的 memory.peak 路徑。同目錄需有 memory.max。
# 來源：backend/tests/reports/test_export_memory.py:22。
# CP4_API_URL=
# CP4_EVENT_ID=
# CP4_EMAIL=
# CP4_PASSWORD=
# CP4_ORIGIN=http://localhost:8080
# CP4_MEMORY_PEAK_PATH=

# ── 壓測（shell 與程序環境，詳見 loadtest/README.md） ──
# loadtest/run.sh 讀 shell 環境；HTTP_PORT 也用於 host 探測，例如
# HTTP_PORT=8081 loadtest/run.sh smoke。runner 假設預設主辦人憑證、
# PostgreSQL 的 ticketing 帳號與資料庫、sid cookie、http://localhost:8080 Origin。
# A、B 共讀 SEATS；A 請用 4 的倍數且不超過 100000，B 至少 16。B_DURATION 為大於 25 的整數秒。
# 來源：loadtest/run.sh:16、loadtest/run.sh:57、loadtest/prepare_a.py:44。
# VUS=3000
# DURATION=60s
# SEATS=10000
# CONNECTIONS=2000
# B_DURATION=80
# B_RATE=100            # 第 1 輪桌機正式跑使用 300（壓力變體）
# SSE_PROCESSES=        # 情境 B 客戶端程序數，預設 min(8, CPU 數)
# SSE_RAMP=10           # 情境 B 連線漸進建立秒數
# K6_CPUS=
# REBUILD=0
# OUT=loadtest/out/<時間戳>
# 直接執行 loadtest/prepare_a.py 時可覆蓋 fixture DSN。run.sh 不轉傳此 shell 變數。
# LOADTEST_DATABASE_URL=
